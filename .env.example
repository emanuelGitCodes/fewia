# Copy this file to .env. Set mode 600. Git ignores .env.
# Fill only nonsecret values here. Do not put access keys or tokens.

FEWIA_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
FEWIA_BEDROCK_REGION=us-east-1
FEWIA_AWS_PROFILE=fewia-bedrock-dev
# Absolute path to the host credentials file.
FEWIA_BEDROCK_CREDENTIALS_FILE=
FEWIA_BEDROCK_ROLE_ARN=
FEWIA_BEDROCK_MFA_SERIAL=

FEWIA_USDA_FDC_ACCOUNT_ID=
FEWIA_USDA_FDC_KEY=
FEWIA_USDA_FDC_KEY_FILE=/absolute/path/to/usda.key

FEWIA_SPOONACULAR_KEY=
FEWIA_SPOONACULAR_KEY_FILE=/absolute/path/to/spoonacular.key
