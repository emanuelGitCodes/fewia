# Copy this file to .env. Set mode 600. Git ignores .env.
# Set nonsecret settings and the OpenAI key below. Keep AWS credentials in files.
# The launcher creates .env0600 and .fewia-state. Keep both private.
# .env0600 stores file paths and the nonroot host UID/GID.
# PostgreSQL and Floci have no default host ports. Use make up-tools for Floci.

FEWIA_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
FEWIA_BEDROCK_REGION=us-east-1
FEWIA_AWS_PROFILE=fewia-bedrock-dev
# Absolute path to the host credentials file.
FEWIA_BEDROCK_CREDENTIALS_FILE=
FEWIA_BEDROCK_ROLE_ARN=
FEWIA_BEDROCK_MFA_SERIAL=

# OpenAI API key for GPT-6 Luna chat. Git ignores .env. Never commit or share it.
FEWIA_OPENAI_API_KEY=
# OpenAI processing region: global (default) or us. The us endpoint costs more.
FEWIA_OPENAI_REGION=global

FEWIA_USDA_FDC_ACCOUNT_ID=
FEWIA_USDA_FDC_KEY=
FEWIA_USDA_FDC_KEY_FILE=/absolute/path/to/usda.key

# Kroger live prices. Use absolute paths to files outside the repository.
# FEWIA_KROGER_CLIENT_ID_FILE=
# FEWIA_KROGER_SECRET_FILE=
# FEWIA_KROGER_ENVIRONMENT=certification
